# 복사해서 .env로 저장하고 값을 채우세요. (.env는 git에 커밋되지 않습니다)

# --- 필수 ---
# BotFather가 준 토큰 (예: 123456789:AAH...)
TELEGRAM_BOT_TOKEN=
# 숫자 chat_id (예: 123456789)
TELEGRAM_CHAT_ID=

# --- 권장 ---
# 없으면 비워 두세요. 소개문이 기본 문장으로 나갑니다. (예: sk-ant-...)
ANTHROPIC_API_KEY=
# 없으면 ytmusicapi 검색 실패 시 대체 검색을 하지 않습니다.
YOUTUBE_API_KEY=

# --- 선택 ---
# CLAUDE_MODEL=claude-opus-5-5
# 봇 명령을 허용할 추가 chat id (쉼표 구분). TELEGRAM_CHAT_ID는 자동 포함.
# TELEGRAM_ALLOWED_CHAT_IDS=
# JAZZBOT_TIMEZONE=Asia/Seoul
# LOG_LEVEL=INFO
# 로컬 예약 실행에 쓸 Python. 비워 두면 conda 환경 "jazzbot" → .venv 순서로 자동으로 찾습니다.
# JAZZBOT_PYTHON=~/miniconda3/envs/jazzbot/bin/python

# YouTube Music "Daily Jazz" 플레이리스트 자동 추가 (선택)
# browser.json(또는 oauth.json) 파일 내용을 한 줄 JSON으로 넣습니다.
# YTMUSIC_AUTH_JSON={"cookie": "...", "x-goog-authuser": "0", ...}
# OAuth 방식일 때만 필요:
# YTMUSIC_OAUTH_CLIENT_ID=
# YTMUSIC_OAUTH_CLIENT_SECRET=
# 이미 만든 플레이리스트를 쓰려면 ID 지정 (없으면 이름으로 찾거나 새로 만듦)
# YTMUSIC_PLAYLIST_ID=
# YTMUSIC_PLAYLIST_NAME=Daily Jazz
